[Unit]
Description=KURINJI Indigenous Bridge System - FastAPI Backend
After=network.target

[Service]
User=root
WorkingDirectory=/var/www/kurinji
ExecStart=/var/www/kurinji/.venv/bin/uvicorn backend.app.main:app --host 127.0.0.1 --port 8000 --workers 2
Restart=always
RestartSec=3
Environment="PATH=/var/www/kurinji/.venv/bin:/usr/local/bin:/usr/bin"
EnvironmentFile=-/var/www/kurinji/.env

[Install]
WantedBy=multi-user.target

