# ==============================================================================
# KURINJI — Git Ignore Configuration (Production & Security Optimized)
# ==============================================================================

# Python Virtual Environments
.venv/
venv/
ENV/
env/

# Python Bytecode & Testing Caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/

# Node.js Dependencies & Frontend Production Builds
node_modules/
frontend/node_modules/
frontend/dist/

# Sensitive Environment Variables & API Keys
.env
.env.local
.env.*.local
!.env.example

# SQLite Database Runtime Journal & Backup Files
*.db-shm
*.db-wal
*.db-journal
*.db.bak

# Large Raw Dataset Folders
dataset/
backend/data/embeddings/*.npy

# Temporary Recording Audio Dumps
backend/data/audio/raw/*
!backend/data/audio/raw/.gitkeep

# Temporary WAV test files at root (preserve native frontend audio assets)
/*.wav
!frontend/public/audio/*.wav

# Operating System & IDE Clutter
.DS_Store
Thumbs.db
.vscode/
.idea/
*.bak
.agents/
.taste-skill/
skills-lock.json
